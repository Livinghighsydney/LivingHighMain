# Frontend env — copy to .env.local and fill in. NEVER commit real values.
# NEXT_PUBLIC_* vars are exposed to the browser; keep secrets out of them.

# Base URL of the FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics / remarketing — REUSE existing IDs (see CLAUDE.md). Do not mint new ones.
NEXT_PUBLIC_GTM_ID=GTM-T4NPBPPZ
NEXT_PUBLIC_META_PIXEL_ID=2502462696653746

