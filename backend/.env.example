# Backend env — copy to .env and fill in. NEVER commit real values.
# In production these live in Railway env vars (see CLAUDE.md security requirements).

ENVIRONMENT=development

# Comma-separated list of allowed CORS origins — the actual frontend domain(s).
# NEVER use "*" (CLAUDE.md: CORS locked to the real frontend domain).
CORS_ORIGINS=http://localhost:3000

# Postgres connection string
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/livinghigh

# Error monitoring (leave blank to disable in local dev)
SENTRY_DSN=

# WordPress export source (migration only — WP REST API)
WP_BASE_URL=https://livinghigh.com.au
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Cloudinary (image migration target)
CLOUDINARY_URL=
